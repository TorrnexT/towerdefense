{
  "name": "@emberwatch/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --external:@colyseus/* --external:express --outdir=dist",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@colyseus/core": "0.18.11",
    "@colyseus/ws-transport": "0.18.2",
    "@emberwatch/shared": "*",
    "express": "^5.2.1",
    "qs": "6.16.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "esbuild": "^0.25.0"
  }
}
